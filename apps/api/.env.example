# Conexión a PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gopark
# Secreto para firmar los JWT (debe ser el MISMO valor en apps/web/.env.local)
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=8h
PORT=4000
# Origen del frontend (CORS)
WEB_ORIGIN=http://localhost:3000
# true en producción (HTTPS)
COOKIE_SECURE=false
